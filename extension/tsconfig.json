{
    "compilerOptions": {
        "target": "ES6",
        "lib": [
            "DOM",
            "ES2015"
        ],
        "module": "ES6",
        "moduleResolution": "Node",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "jsx": "react"
    },
    "include": [
        "src/**/*"
    ]
}